# Ejemplo de configuración local — copiar a backend/.env (no se sube al repo)
# (Ver docs/demo/VARIABLES_ENTORNO.md para el detalle de cada variable.)

# Entorno: desarrollo (default, demo local) | produccion
# Con "produccion": DEBUG forzado a 0, DJANGO_SECRET_KEY y DJANGO_ALLOWED_HOSTS
# obligatorios, cookies/HTTPS endurecidos.
DJANGO_ENV=desarrollo

# Demostración local: dejar 1 (sirve /static/ y /media/ con runserver).
# En producción debe quedar 0 (además DJANGO_ENV=produccion lo impide).
DJANGO_DEBUG=1

# Solo obligatorio con DJANGO_ENV=produccion. Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# DJANGO_SECRET_KEY=

# Solo obligatorio con DJANGO_ENV=produccion (lista separada por comas).
# DJANGO_ALLOWED_HOSTS=citi.ejemplo.edu.co

# Base de datos. Sin DATABASE_URL => SQLite local (backend/db.sqlite3).
# DATABASE_URL=postgres://usuario:contrasena@localhost:5432/citi

# Umbrales del filtro académico de estudiantes tutor.
CITI_MIN_SEMESTRE_TUTOR=8
CITI_MIN_CREDITOS_TUTOR=130
CITI_MIN_PROMEDIO_TUTOR=4.0

# Contraseña de las cuentas creadas por `manage.py seed_demo` (solo local).
# Si se omite usa el valor de accounts/demo_seed.py. NO reutilizar en sistemas reales.
CITI_DEMO_PASSWORD=CITIPass2026*

# Días de HSTS en producción (0 para desactivar).
DJANGO_HSTS_SECONDS=31536000
