# Variables para `docker compose up --build`.
# Copiar a `.env` (misma carpeta que docker-compose.yml) solo si hace falta
# cambiar los valores por defecto. TODOS los valores son de demostración.

# Puerto publicado en el host -> contenedor 8000.
PORT=8000

# Contraseña compartida por las cuentas demo creadas por seed_demo_data.
CITI_DEMO_PASSWORD=CITIPass2026*

# 1 = migrar + sembrar datos demo al arrancar (idempotente).
# 0 = arrancar sin tocar la base (útil si ya se sembró y no se quiere recalcular).
CITI_SEED_ON_START=1

# Clave de Django. En una demo local puede quedarse así; en producción real
# debe ser única y secreta.
DJANGO_SECRET_KEY=docker-demo-citi-ucc-cambiar-en-produccion

# Workers de Gunicorn (para un portátil de exposición, 3 es suficiente).
GUNICORN_WORKERS=3
